# Client-accessible Supabase variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only Supabase Service Role Key (NEVER expose to browser / client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Company Trust Wallet Receiving Addresses (Optional - If unset, derived per-user)
NEXT_PUBLIC_TRUST_WALLET_TRC20=TX_your_trust_wallet_tron_usdt_address_here
NEXT_PUBLIC_TRUST_WALLET_BEP20=0x_your_trust_wallet_bsc_usdt_address_here
NEXT_PUBLIC_TRUST_WALLET_POLYGON=0x_your_trust_wallet_polygon_usdt_address_here

